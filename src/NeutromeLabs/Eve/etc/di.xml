<?xml version="1.0"?>
<!--
/**
 * Neutrome Eve - Dependency Injection Configuration
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Logger for Eve module -->
    <virtualType name="NeutromeLabs\Eve\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/neutrome_eve.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="NeutromeLabs\Eve\Logger\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">neutrome_eve</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">NeutromeLabs\Eve\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    
    <!-- Inject logger into services -->
    <type name="NeutromeLabs\Eve\Service\ApiClient">
        <arguments>
            <argument name="logger" xsi:type="object">NeutromeLabs\Eve\Logger\Logger</argument>
        </arguments>
    </type>
    
    <type name="NeutromeLabs\Eve\Plugin\EventManagerPlugin">
        <arguments>
            <argument name="logger" xsi:type="object">NeutromeLabs\Eve\Logger\Logger</argument>
        </arguments>
    </type>
    
    <type name="NeutromeLabs\Eve\Service\FeedProcessor">
        <arguments>
            <argument name="logger" xsi:type="object">NeutromeLabs\Eve\Logger\Logger</argument>
        </arguments>
    </type>
    
    <type name="NeutromeLabs\Eve\Service\CustomerBlockService">
        <arguments>
            <argument name="logger" xsi:type="object">NeutromeLabs\Eve\Logger\Logger</argument>
        </arguments>
    </type>
    
    <type name="NeutromeLabs\Eve\Cron\PollFeed">
        <arguments>
            <argument name="logger" xsi:type="object">NeutromeLabs\Eve\Logger\Logger</argument>
        </arguments>
    </type>
    
    <!-- CLI Commands -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="eve_poll_feed" xsi:type="object">NeutromeLabs\Eve\Console\Command\PollFeedCommand</item>
            </argument>
        </arguments>
    </type>
    
    <!-- Plugin on Magento Event Manager - intercepts ALL events BEFORE observers -->
    <type name="Magento\Framework\Event\Manager">
        <plugin name="neutrome_eve_event_interceptor" 
                type="NeutromeLabs\Eve\Plugin\EventManagerPlugin" 
                sortOrder="1"/>
    </type>
    
    <!-- Plugin on Magento Logger - intercepts log messages for anomaly detection -->
    <type name="Psr\Log\LoggerInterface">
        <plugin name="neutrome_eve_logger_interceptor"
                type="NeutromeLabs\Eve\Plugin\LoggerPlugin"
                sortOrder="100"/>
    </type>
</config>
